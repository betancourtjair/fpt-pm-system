# Copia este archivo a .env para desarrollo local (docker compose ya inyecta estos valores).
# En Render, configura estas mismas variables en el dashboard del Web Service (no se suben aquí).

# Cadena de conexión de PostgreSQL (local: docker compose; producción: Supabase → Settings → Database → Connection string, modo "Transaction" o "Session")
DATABASE_URL=postgresql://fpt_user:fpt_pass@localhost:5432/fpt_pm?schema=public

# Redis (local: docker compose; producción: Upstash → cadena de conexión "rediss://...")
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_.env
JWT_EXPIRES_IN=8h

# CORS: dominio(s) del frontend, separados por coma. En local, el de Vite.
CORS_ORIGIN=http://localhost:5173

# Puerto en el que escucha el backend (Render lo inyecta automáticamente)
PORT=3000

# Correo transaccional (Resend) — se usa a partir de la Fase 2 (alertas), no en este primer montado.
RESEND_API_KEY=
