# Copia este archivo a .env para desarrollo local (docker compose ya inyecta estos valores).
# En Render, configura estas mismas variables en el dashboard del Web Service (no se suben aquí).

# Cadena de conexión de PostgreSQL (local: docker compose; producción: Supabase → Settings → Database → Connection string, modo "Transaction" o "Session")
DATABASE_URL=postgresql://fpt_user:fpt_pass@localhost:5432/fpt_pm?schema=public

# Redis (local: docker compose; producción: Upstash → cadena de conexión "rediss://...")
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_.env
JWT_EXPIRES_IN=8h

# CORS: dominio(s) del frontend, separados por coma. En local, el de Vite.
CORS_ORIGIN=http://localhost:5173

# Puerto en el que escucha el backend (Render lo inyecta automáticamente)
PORT=3000

# Correo transaccional (Resend) — Fase 2 (alertas). Sin esta key, el sistema
# sigue funcionando normal, solo que las alertas quedan marcadas "fallido"
# en vez de mandarse (ver EmailService).
RESEND_API_KEY=

# Remitente de las alertas — debe ser un correo @fpt.com.mx (el dominio
# raíz que aparece "Verified" en Resend). NUNCA @send.fpt.com.mx: ese
# subdominio solo trae el Return-Path/bounce interno (MX+TXT), no está
# verificado como remitente y Resend rechaza el correo si se usa ahí.
# Opcional: si se deja vacío se usa el remitente por defecto de email.service.ts.
EMAIL_REMITENTE="Notificaciones FPT <notificaciones@fpt.com.mx>"

# URL del frontend (Netlify) — se usa solo para armar el botón "Ver en el
# sistema" dentro de los correos de alerta. Opcional.
FRONTEND_URL=http://localhost:5173
